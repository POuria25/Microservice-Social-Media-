# Gateway Database
GATEWAY_POSTGRES_USER=postgres
GATEWAY_POSTGRES_PASSWORD=gateway_password
GATEWAY_POSTGRES_DB=gateway
GATEWAY_POSTGRES_DSN=postgres://postgres:gateway_password@gateway-db:5432/gateway?sslmode=disable

# JWT Secret
JWT_SECRET=my_super_secret_key_change_in_production_please

# Service URLs (pointing directly to services for now, will use load-balancers later)
USER_SERVICE_URL=http://load-balancer:9001
POST_SERVICE_URL=http://load-balancer:9002
FEED_SERVICE_URL=http://feed-service:5000

# User Service Database
USER_POSTGRES_USER=postgres
USER_POSTGRES_PASSWORD=user_password
USER_POSTGRES_DB=userdb
USER_POSTGRES_DSN=postgres://postgres:user_password@user-db:5432/userdb?sslmode=disable

# Post Service Database
POST_POSTGRES_USER=postgres
POST_POSTGRES_PASSWORD=post_password
POST_POSTGRES_DB=postdb
POST_POSTGRES_DSN=postgres://postgres:post_password@post-db:5432/postdb?sslmode=disable